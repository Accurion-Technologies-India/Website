# Accurion Technologies - Clean URLs & Security Configuration
RewriteEngine On
RewriteBase /

# 1. Redirect /index.html to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ / [R=301,L]

# 2. Redirect /subfolder/index.html to /subfolder/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)/index\.html\ HTTP/
RewriteRule ^(.*)/index\.html$ /$1/ [R=301,L]

# 3. Externally redirect *.html requests to clean URLs (301 redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html [NC]
RewriteRule ^([^\ ]+)\.html$ /$1 [R=301,L]

# 4. Internally rewrite extensionless URLs to .html files if they exist
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# 5. Security & Browser Caching Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
